# ==============================
# 1) 공공데이터 OpenAPI
# ==============================
# 활용신청 후 받은 실제 호출 URL을 입력하세요.
VITE_PUBLIC_DATA_API_URL=https://api.kcisa.kr/openapi/API_CIA_090/request


# 인증키가 query parameter로 필요한 API라면 입력하세요.
VITE_PUBLIC_DATA_SERVICE_KEY=8c7884ac-dedc-49ac-bae9-dab8111651cd

VITE_PUBLIC_DATA_KEY_PARAM=serviceKey

# API별 추가 query string. 예: pageNo=1&numOfRows=1000
VITE_PUBLIC_DATA_EXTRA_PARAMS=pageNo=1&numOfRows=1000

# 키/URL 미설정 때 샘플 데이터로 앱을 시연할지 여부
VITE_USE_MOCK_WHEN_UNCONFIGURED=true

# ==============================
# 2) Kakao Maps JavaScript API
# ==============================
VITE_KAKAO_MAP_KEY=18c8508b256818bfd7519b07216214dc
